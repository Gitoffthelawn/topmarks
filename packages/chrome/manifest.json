{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.0.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "homepage_url": "https://github.com/nx-alejandrolacasa/topmarks",
  "permissions": ["bookmarks", "storage", "search", "favicon"],
  "host_permissions": ["https://api.unsplash.com/*"],
  "icons": { "128": "icons/icon.png" },
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "minimum_chrome_version": "120",
  "browser_specific_settings": {
    "gecko": {
      "id": "topmarks-chrome@nx-alejandrolacasa.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
