{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "__VERSION__",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "homepage_url": "https://github.com/nx-alejandrolacasa/topmarks",
  "developer": {
    "name": "Alejandro Lacasa",
    "url": "https://github.com/nx-alejandrolacasa"
  },
  "permissions": ["bookmarks", "storage", "search"],
  "host_permissions": ["https://api.unsplash.com/*"],
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "browser_specific_settings": {
    "gecko": {
      "id": "topmarks@nx-alejandrolacasa.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
